DATABASE_URL=postgresql://[user]:[pass]@localhost:5432/[db name]
BOLSAI_API_KEY=[your bolsai API key]
TIMESCALE_CNN=postgres://[user]:[pass]@[host].tsdb.cloud.timescale.com:[port]/tsdb?sslmode=require&uselibpqcompat=true
JWT_SECRET=[random secret, e.g. `openssl rand -hex 32` — unused once RS256 migration is fully rolled out, kept for backward compat]
JWT_EXPIRES_IN=604800
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
[your RSA private key, generated via `openssl genrsa`]
-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
[your RSA public key, derived from the private key above]
-----END PUBLIC KEY-----"

# Fase 11 (Redis/cache de cotações) — Upstash REST API
UPSTASH_REDIS_REST_URL=https://[your-db].upstash.io
UPSTASH_REDIS_REST_TOKEN=[your Upstash REST token]